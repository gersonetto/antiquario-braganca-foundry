<div class="ab-sorteio-header">
  <div>
    <h2 style="font-family: var(--font-primary, 'Cormorant Garamond', serif); margin: 0;">{{modoTitle}}</h2>
    <p style="font-size: 0.78rem; color: var(--ab-ink-muted); margin: 0.2em 0 0;">{{rarityLabel}} · {{categoryLabel}}</p>
  </div>
  <button type="button" class="ab-btn" data-action="back-to-config">{{localize 'ANTIQUARIO.Sorteio.back'}}</button>
</div>

{{#if warning}}
  <p class="ab-warning">{{warning}}</p>
{{/if}}

{{#if empty}}
  <p class="ab-empty">{{localize 'ANTIQUARIO.Sorteio.empty'}}</p>
{{else}}
  <section class="ab-grid">
    {{#each slots}}
      <div class="ab-sorteio-slot">
        {{> antiquario-braganca-item-card item}}
        <div class="ab-sorteio-slot__footer">
          {{#if guaranteedCategory}}
            <span class="ab-sorteio-guaranteed">{{localize 'ANTIQUARIO.Sorteio.guaranteed'}}</span>
          {{else}}
            <span></span>
          {{/if}}
          <button type="button" class="ab-chat-reroll" data-action="reroll-slot" data-slot-index="{{slotIndex}}">{{localize 'ANTIQUARIO.Sorteio.reroll'}}</button>
        </div>
      </div>
    {{/each}}
  </section>
  <button type="button" class="ab-sorteio-submit" data-action="publish" style="margin-top: 0.75rem;">{{localize 'ANTIQUARIO.Sorteio.publish'}}</button>
{{/if}}
